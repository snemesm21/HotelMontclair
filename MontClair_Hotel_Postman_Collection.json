            "url": "{{baseUrl}}/api/auth/google/exchange"
          }
        },
        {
          "name": "Google OAuth Callback (Browser redirect)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/login/oauth2/code/google?code=SAMPLE&state=SAMPLE",
              "host": ["{{baseUrl}}"],
              "path": ["login", "oauth2", "code", "google"],
              "query": [
                { "key": "code", "value": "SAMPLE" },
                { "key": "state", "value": "SAMPLE" }
              ]
            }
          }
        }
      ]
