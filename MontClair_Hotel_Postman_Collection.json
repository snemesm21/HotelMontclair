{
  "info": {
    "_postman_id": "a7e9d3b0-5d22-4f9b-b5d9-montclair2026",
    "name": "MontClair Grand Hotel API (JWT & Roles)",
    "description": "Colección completa de todos los endpoints del backend Spring Boot de MontClair Grand Hotel. Incluye scripts automáticos en los endpoints de Login para guardar el JWT en la variable {{token}} y probar la seguridad por roles (ADMIN, OPERATOR, CLIENT).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Auth (JWT & Sesión)",
      "description": "Autenticación, obtención automática del JWT ({{token}}), sesión actual (/me), logout, CSRF y Google OAuth.",
      "item": [
        {
          "name": "Login ADMIN (guarda {{token}})",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data && data.token) {",
                  "    pm.collectionVariables.set('token', data.token);",
                  "    console.log('JWT ADMIN guardado:', data.role);",
                  "}",
                  "pm.test('Login exitoso (200)', () => pm.response.to.have.status(200));",
                  "pm.test('Incluye JWT', () => pm.expect(data.token).to.be.a('string').and.not.empty);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"admin\",\n  \"password\": \"admin\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Inicia sesión como ADMIN y guarda automáticamente el JWT en {{token}}."
          }
        },
        {
          "name": "Login OPERATOR (guarda {{token}})",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data && data.token) {",
                  "    pm.collectionVariables.set('token', data.token);",
                  "    console.log('JWT OPERATOR guardado:', data.role);",
                  "}",
                  "pm.test('Login exitoso (200)', () => pm.response.to.have.status(200));",
                  "pm.test('Incluye JWT', () => pm.expect(data.token).to.be.a('string').and.not.empty);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"operario\",\n  \"password\": \"operario\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Inicia sesión como OPERATOR y guarda automáticamente el JWT en {{token}}."
          }
        },
        {
          "name": "Login CLIENT (demo - guarda {{token}})",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data && data.token) {",
                  "    pm.collectionVariables.set('token', data.token);",
                  "    console.log('JWT CLIENT guardado:', data.role);",
                  "}",
                  "pm.test('Login exitoso (200)', () => pm.response.to.have.status(200));",
                  "pm.test('Incluye JWT', () => pm.expect(data.token).to.be.a('string').and.not.empty);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"demo\",\n  \"password\": \"demo\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Inicia sesión como CLIENT (usuario demo) y guarda automáticamente el JWT en {{token}}."
          }
        },
        {
          "name": "Get Current Session (/me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/me",
            "description": "Devuelve el cliente autenticado (ClientDTO), rol y redirectUrl validando el JWT Bearer o cookie."
          }
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('token', '');",
                  "pm.test('Logout exitoso (200)', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/logout",
            "description": "Cierra la sesión en el backend (borra cookie HM_SESSION) y limpia {{token}} en Postman."
          }
        },
